APP_ENV=development
LOG_LEVEL=INFO
BUSINESS_NAME=our office
BUSINESS_TIMEZONE=Africa/Lagos
# Use your public HTTPS origin (no trailing path) for Twilio/Railway.
PUBLIC_BASE_URL=
# Optional locally; REQUIRED (32+ random characters) in production.
# Swagger /docs -> Authorize -> X-API-Key.
API_ACCESS_KEY=
CORS_ORIGINS=[]

# LLM Provider: "auto", "openai", or "gemini"
LLM_PROVIDER=auto

# Option A: OpenAI (Paid - https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Option B: Google Gemini (100% Free - get key at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_ENDPOINTING_MS=300
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true
SUPABASE_URL=
# Use the service_role/secret server key, never the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

PROVIDER_TIMEOUT_SECONDS=25
VOICE_TURN_TIMEOUT_SECONDS=35
MAX_TOOL_ROUNDS=4
MAX_UPLOAD_BYTES=10485760
MAX_CALL_SECONDS=1800
MAX_CONCURRENT_CALLS=20
WEB_CONCURRENCY=1
